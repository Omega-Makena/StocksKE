# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# ── News API (https://newsapi.org) ────────────────────────
NEWS_API_KEY=your_newsapi_org_key_here

# ── LLM (OpenAI or any compatible endpoint) ───────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=1500

# ── Pipeline data paths ───────────────────────────────────
OUTPUT_DIR=nse_dataset
COMPILED_DIR=compiled_securities    # folder produced by importer build-csv
PRICE_CSV_PATH=                     # leave blank; pipeline builds it from COMPILED_DIR

# ── Prediction tuning ─────────────────────────────────────
PRICE_CHANGE_THRESHOLD=1.5          # % move to call UP or DOWN
LOOKAHEAD_DAYS=3                    # days after article to check price
CONFIDENCE_THRESHOLD=0.3            # minimum LLM confidence to keep

# ── Production system (production/) ───────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/stocks_db
REDIS_URL=redis://localhost:6379/0
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
PREDICTION_THRESHOLD=0.7

# ── StocksKE news ingestion ───────────────────────────────
KNOWLEDGE_GRAPH_PATH=path/to/nse_knowledge_graph_data.json
NEWS_DB_PATH=nse_news_database.db
